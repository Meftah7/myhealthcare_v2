# Report AI gateway — example configuration. Copy to a file Git ignores
# (for example services/report_ai/.env) or, in production, put these values in
# your secret manager. Never commit a real key, and never pass it to Flutter:
# the app only knows the gateway origin and a client token.
#
#   node --env-file=services/report_ai/.env services/report_ai/server.mjs

# DeepSeek API key (server only).
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# Optional. The DeepSeek model to call.
DEEPSEEK_MODEL=deepseek-flash

# Client installation tokens the app may present (comma-separated, 32+
# characters each). Generate one with:
#   node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
REPORT_AI_CLIENT_TOKENS=<client-token>

# Web builds only: the origins allowed to call the gateway.
REPORT_AI_ORIGINS=http://localhost:8080

# Optional. Loopback port.
PORT=8790
